#include <stdio.h>
#include <stdlib.h>

int main() {
    int a, b, c, d, e, f, ch;

    printf("Enter Your 1st Number:- \n");
    scanf("%d", &a);

    printf("Enter Your 2nd Number:- \n");
    scanf("%d", &b);

    while (1) {
        printf("\n 1.addition \n");
        printf("\n 2.Subtraction \n");
        printf("\n 3.Multiplication\\Even \n");
        printf("\n 4.Division \n");
        printf("\n 5.Exit \n");
        printf("Enter Your Choice: ");
        scanf("%d", &ch);

        switch (ch) {
            case 1:
                c = a + b;
                printf("%d", c);
                break;

            case 2:
                d = a - b;
                printf("%d", d);
                break;

            case 3:
                e = a * b;
                printf("%d", e);
                break;

            case 4:
                if (b != 0) {
                    f = a / b;
                    printf("%d", f);
                } else {
                    printf("Error: Division by zero");
                }
                break;

            case 5:
                printf("Not Valid");
                break;

            default:
                printf("Invalid Choice");
                break;
        }

        if (ch == 5) {
            exit(0);
        }
    }

    return 0;
}
