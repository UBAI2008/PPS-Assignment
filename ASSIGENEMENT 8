#include <stdio.h>

int swapr(int*, int*);

int main() {
    int a;
    int b;

    printf("Enter the values of a and b\n");
    scanf("%d %d", &a, &b);

    printf("a=%d,\nb=%d\n", a, b);

    swapr(&a, &b);
    printf("After Swapping\n");
    printf("a=%d,\nb=%d", a, b);

    return 0;
}

int swapr(int *x, int *y) {
    int t;
    t = *x;
    *x = *y;
    *y = t;
}
