#include <stdio.h>

int fact_rec(int num);

int main() {
    int num;
    int result;

    printf("Enter Your Number");
    scanf("%d", &num);

    result = fact_rec(num);
    printf("Your Result is= %d", result);

    return 0;
}

int fact_rec(int num) {
    if (num == 1)
        return 1;
    else
        return num * fact_rec(num - 1);
}
